APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Production profile:
# APP_ENV=production

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=devlens
POSTGRES_PASSWORD=devlens
POSTGRES_DB=devlens
POSTGRES_SSLMODE=disable
POSTGRES_DSN=postgres://devlens:devlens@localhost:5432/devlens?sslmode=disable
# Production example:
# POSTGRES_DSN=postgres://<user>:<password>@<host>:5432/<database>?sslmode=require
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=0
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_MAX_CONN_IDLE_TIME=5m
POSTGRES_HEALTH_CHECK_PERIOD=1m
POSTGRES_CONNECT_TIMEOUT=5s

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=devlens
CLICKHOUSE_USER=devlens
CLICKHOUSE_PASSWORD=devlens
CLICKHOUSE_DSN=http://devlens:devlens@localhost:8123
# Production without ClickHouse:
# CLICKHOUSE_DSN=

GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_USER_AGENT=devlens-api
GITHUB_HTTP_TIMEOUT=10s
GITHUB_MAX_RETRIES=3
GITHUB_INITIAL_BACKOFF=500ms
GITHUB_MAX_BACKOFF=5s
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_INSTALL_URL=
GITHUB_APP_PRIVATE_KEY=

NATS_URL=nats://localhost:4222
# Production without NATS:
# NATS_URL=

COMPOSE_PROJECT_NAME=devlens
SYNC_WORKER_POLL_INTERVAL=2s
WEBHOOK_RETRY_INTERVAL=10s
BACKUP_DIR=./backups/postgres
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
OTEL_ENABLED=false
OTEL_SERVICE_NAME=devlens-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACE_SAMPLE_RATIO=1
